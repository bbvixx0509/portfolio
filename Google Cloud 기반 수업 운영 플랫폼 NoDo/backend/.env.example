# NoDo backend environment variable names only. Do not commit local values.
# Runtime selection: emulator (default) or cloud-auth.
NODO_RUNTIME_MODE=
# Firebase project identifier for the selected runtime.
NODO_FIREBASE_PROJECT_ID=
# Real Firestore database id. Cloud-auth accepts only (default).
NODO_FIRESTORE_DATABASE_ID=(default)
# Fixed Bootstrap organization contract. Do not accept these from browsers.
NODO_BOOTSTRAP_ORG_ID=demo
NODO_BOOTSTRAP_ORG_NAME=DEMO
# One-time organization creation gate. Set false after successful Bootstrap.
NODO_BOOTSTRAP_ENABLED=true
# Comma-separated, exact-match Bootstrap owner emails (server only).
# This may be empty when NODO_BOOTSTRAP_ENABLED=false.
NODO_BOOTSTRAP_ORG_OWNER_EMAILS=
# Exact company domains allowed for staff invitations.
NODO_STAFF_EMAIL_DOMAINS=nodo-company.test
# Invitation lifetime in hours (7 days by default).
NODO_STAFF_INVITATION_TTL_HOURS=168
# Comma-separated browser origins allowed by FastAPI CORS.
NODO_CORS_ORIGINS=
# Private NoDo material upload. Keep disabled for local/Emulator work.
# cloud-auth accepts only the fixed NoDo bucket and matching project.
NODO_STORAGE_MODE=disabled
NODO_STORAGE_BUCKET=
GOOGLE_CLOUD_PROJECT=
# Server-only Vertex AI draft generation. Keep disabled until separately approved.
# The fixed model uses the Vertex global endpoint and ADC; never add a browser API key.
NODO_VERTEX_AI_MODE=disabled
NODO_VERTEX_AI_LOCATION=global
NODO_VERTEX_AI_MODEL=gemini-2.5-flash
NODO_VERTEX_AI_MAX_INPUT_CHARACTERS=24000
