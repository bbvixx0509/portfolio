# Production contract only. Copy to a local deployment environment; never commit values.
NODO_RUNTIME_MODE=cloud-auth
APP_ENV=production
NODO_FIREBASE_PROJECT_ID=example-gcp-project
NODO_FIRESTORE_DATABASE_ID=(default)
NODO_BOOTSTRAP_ORG_ID=demo
NODO_BOOTSTRAP_ORG_NAME=DEMO
NODO_BOOTSTRAP_ENABLED=false
NODO_STAFF_EMAIL_DOMAINS=nodo-company.test
NODO_STAFF_INVITATION_TTL_HOURS=168
NODO_CORS_ORIGINS=https://example-gcp-project-nodo.web.app,https://example-gcp-project-nodo.firebaseapp.com,http://localhost:5175
NODO_STORAGE_MODE=cloud
NODO_STORAGE_BUCKET=example-gcp-project-nodo-materials
GOOGLE_CLOUD_PROJECT=example-gcp-project
# Keep Vertex disabled unless its separately approved runtime permission is granted.
NODO_VERTEX_AI_MODE=disabled
NODO_VERTEX_AI_LOCATION=global
NODO_VERTEX_AI_MODEL=gemini-2.5-flash
NODO_VERTEX_AI_MAX_INPUT_CHARACTERS=24000
