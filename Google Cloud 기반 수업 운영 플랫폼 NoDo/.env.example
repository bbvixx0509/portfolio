# NoDo_02 local-only reference. Vite reads web/.env.example values and
# FastAPI uses backend/.env.example values; no real Firebase values belong here.
VITE_APP_VERSION=02
VITE_NODO_RUNTIME_MODE=emulator
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-nodo
VITE_FIREBASE_API_KEY=local-demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nodo.localhost
VITE_FIREBASE_STORAGE_BUCKET=demo-nodo.appspot.com
VITE_FIREBASE_APP_ID=1:000000000000:web:local-nodo-02
VITE_FIREBASE_AUTH_HOST=127.0.0.1
VITE_FIREBASE_AUTH_PORT=9099
VITE_FIREBASE_FIRESTORE_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_PORT=8081
VITE_FIREBASE_STORAGE_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_PORT=9199
APP_ENV=local
APP_NAME=NoDo
APP_VERSION=02
NODO_RUNTIME_MODE=emulator
CORS_ORIGINS=http://127.0.0.1:5174
NODO_FIREBASE_PROJECT_ID=demo-nodo
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Storage uploads stay disabled in the Emulator. Cloud-auth configuration belongs
# only in ignored local backend environment files.
NODO_STORAGE_MODE=disabled
NODO_STORAGE_BUCKET=
GOOGLE_CLOUD_PROJECT=
# Vertex AI course drafts are server-only and disabled by default.
NODO_VERTEX_AI_MODE=disabled
NODO_VERTEX_AI_LOCATION=global
NODO_VERTEX_AI_MODEL=gemini-2.5-flash
NODO_VERTEX_AI_MAX_INPUT_CHARACTERS=24000
