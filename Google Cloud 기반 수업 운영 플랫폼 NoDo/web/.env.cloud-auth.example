# 실제 값은 커밋하지 않는 .env.cloud-auth.local에만 입력합니다.
VITE_NODO_RUNTIME_MODE=cloud-auth
# 로컬 실제 NoDo Cloud 개발 시에만 1로 설정합니다. production build에는 사용하지 않습니다.
VITE_LOCAL_REAL_NODO_CLOUD=
VITE_APP_VERSION=02
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
