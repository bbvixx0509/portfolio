# Public Firebase web configuration is injected only by the deployment environment.
# Do not commit a filled .env.production file.
VITE_NODO_RUNTIME_MODE=cloud-auth
VITE_APP_VERSION=02
# Copy the generated HTTPS URL for nodo-api after Cloud Run deployment.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=example-gcp-project
VITE_FIREBASE_STORAGE_BUCKET=example-gcp-project-nodo-materials
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
