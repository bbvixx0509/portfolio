PORT=8080
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081

# Set to true for a local, embedded PostgreSQL database when Docker/PostgreSQL is unavailable.
# This must remain unset in GKE/Cloud SQL deployments.
LOCAL_PGLITE=false
LOCAL_PGLITE_PATH=.pglite
# `npm run db:seed-demo` is allowed only when this is true.
# Keep false in shared, staging, and production environments.
SEED_DEMO_DATA=false

# Readiness fails quickly instead of holding Kubernetes probe connections.
DB_HEALTH_TIMEOUT_MS=1500
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=1500
DB_STATEMENT_TIMEOUT_MS=5000
DB_RANDOM_PAGE_COST=1.0
SEARCH_CONCURRENCY=2
SEARCH_QUEUE_MAX=20
SEARCH_QUEUE_TIMEOUT_MS=1500
PRODUCT_COUNT_TTL_MS=30000
# This source is a recalculation of existing rows, not an external data import.
SYNC_REQUIRED_SOURCES=allergen_projection

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=foodiguard
DB_USER=postgres
DB_PASSWORD=change_me

# 관리형 PostgreSQL(Render·Neon 등)을 쓸 때는 위 항목 대신 접속 문자열 하나만 지정합니다.
# 이 값이 있으면 SSL이 자동으로 켜집니다.
# DATABASE_URL=postgresql://user:password@host/dbname
# DB_SSL=true

GOOGLE_CLOUD_PROJECT=example-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash

# 세션 토큰 서명 키. 비워 두면 기동할 때마다 임시 키를 만들어 재시작·다중 인스턴스에서
# 로그인이 유지되지 않는다. 배포 환경에서는 반드시 설정한다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=1209600
